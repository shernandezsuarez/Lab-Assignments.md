### STEP 3: I had to download a new dataset that wasn't so big since I didnt have enough storage to use the first dataset for this part. 

mkdir -p ~/Danio_r_raw_reads
cd ~/Danio_r_raw_reads

### I used AI to get a new less dense data set so that I could work with it.
### Downloading new set:
prefetch ERR338827

### fetch FASTQ reads for new data
 # AI advised me to use "-- split files" because the zebrafish dataset contained pair-end sequencing reads
fasterq-dump ERR338827/ERR338827.sra --split-files

### count the number of reads 
wc -l < ERR338827_1.fastq | awk '{print $1/4}'
wc -l < ERR338827_2.fastq | awk '{print $1/4}'

### seeing content 
less ERR338827_1.fastq

### compressing files to reduce disk space usage
gzip ERR338827_1.fastq &
gzip ERR338827_2.fastq &

### see the contents of the compressed file
gzip -dc ERR338827_1.fastq.gz | less
 
### counting the number of reads of compressed file
gzip -dc ERR338827_1.fastq.gz | wc -l | awk '{print $1/4}'
 gzip -dc ERR338827_2.fastq.gz | wc -l | awk '{print $1/4}'

